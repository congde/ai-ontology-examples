@prefix ex: <https://example.org/enterprise/> .
ex:T-001 a ex:Ticket ;
  ex:belongsTo ex:C-001 ;
  ex:relatedEquipment ex:E-001 ;
  ex:status "处理中" .
ex:C-001 a ex:Customer .
ex:E-001 a ex:Equipment ; ex:status "运行中" .
@prefix ex: <https://example.org/enterprise/> .
ex:request-demo a ex:CloseRequest ;
  ex:forTicket ex:T-001 .
@prefix ex: <https://example.org/enterprise/> .
ex:request-demo ex:resolutionRecord ex:resolution-demo .
ex:resolution-demo a ex:ResolutionRecord ;
  ex:forTicket ex:T-003 .
